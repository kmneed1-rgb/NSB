# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase (primary cloud backend — replaces Firebase)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# SECRET (service-role) — sirf server-side scripts ke liye (kabhi client mein nahi)
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json"
# SUPABASE_DB_URL (sirf scripts ke liye): SQL schema chalane ke liye direct DB string.
# Dashboard -> Connect -> Session pooler se lein (ye value kabhi client mein nahi jaati).
SUPABASE_DB_URL="postgresql://postgres:PASSWORD@aws-0-XX.pooler.supabase.co:6543/postgres?sslmode=require"
# SUPABASE_ACCESS_TOKEN: sirf CLI se edge function deploy karne ke liye
# (Dashboard -> Account -> Access Tokens -> Generate new token). Phir: npm run auth:deploy
SUPABASE_ACCESS_TOKEN=""
# Edge function admin allowlist (comma separated)
SUPABASE_ADMIN_EMAILS="ali@nsb1.com,dev@nsb1.com"
# Legacy backup DB (Neon) — sirf scripts ke liye (code mein hardcode na karein)
NEON_CONNECTION="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

